# Supabase Configuration
# Generated from: https://supabase.com/dashboard/project/_/settings/api
# Project: your-project-id
# Last updated: YYYY-MM-DD

# Public keys (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Application Base URL (used for Telegram notifications, SEO, etc.)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Secret keys (server-side only, NEVER commit to git!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Database password (for direct PostgreSQL connections)
DATABASE_PASSWORD=your-database-password
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-id.supabase.co:5432/postgres
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
# ⚠️ SECURITY NOTE:
# This file is gitignored and should NEVER be committed to version control
# Each developer should have their own .env.local file

# Database connection for migrations
DB_HOST=db.your-project-id.supabase.co
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_NAME=postgres

# Telegram Bot Configuration (server-side only)
# Get bot token from: https://t.me/BotFather
TG_BOT_TOKEN=your-telegram-bot-token
TG_BOT_USERNAME=YourBot_bot
TG_WEBHOOK_SECRET=your-webhook-secret-string

# Admin Notifications (optional)
# Your personal Telegram ID for receiving new user/task notifications
# Get your ID by messaging @userinfobot on Telegram
ADMIN_TELEGRAM_ID=your-telegram-user-id

# Resend Email (transactional emails)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# ----------------------------------------------------------------------------
# Outreach automation (scripts/outreach/{fetch,send}.ts)
# Required for: npm run outreach:fetch / outreach:send
# Setup runbook: docs/planning/cold-start-2026-04/07-fetcher-and-sender-scripts.md
# ----------------------------------------------------------------------------

# Apify — Google Maps lead extraction. Token from https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_your-token-here
# Default actor: compass/google-maps-extractor (use the "user/actor" form)
APIFY_ACTOR_ID=compass/google-maps-extractor

# Resend cold-outreach sender — MUST be a verified subdomain (e.g. outreach.trudify.com).
# Never use the main domain (trudify.com) for cold email.
RESEND_API_KEY_OUTREACH=re_your-outreach-key
RESEND_FROM_EMAIL="Alex from TruDify <alex@outreach.trudify.com>"
# Where replies should land (your real inbox, not the cold subdomain).
RESEND_REPLY_TO=alex@trudify.com
# Webhook signing secret from Resend dashboard. Set in Supabase project secrets
# for the resend-webhook edge function — NOT used by Next.js.
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret

# Daily cap for outreach:send. Warm-up: 20 → 50 → 100 over 3 weeks.
OUTREACH_DAILY_CAP=20

# HMAC secret for signed unsubscribe tokens (must be ≥ 32 chars, random).
# Generate: openssl rand -base64 48
OUTREACH_UNSUBSCRIBE_SECRET=replace-me-with-32-or-more-random-chars-please
